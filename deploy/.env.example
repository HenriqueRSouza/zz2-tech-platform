# Tech Support Platform (TSP) — environment
#
# Copy to /etc/zz2/zz2.env on the VPS, fill in the real values, then:
#
#   sudo chown root:zz2 /etc/zz2/zz2.env
#   sudo chmod 640 /etc/zz2/zz2.env
#
# 0640 root:zz2 is the point: the service reads it, nobody else on the box can.
# This file replaces config.json for everything secret. config.json survives only
# for non-secret, operator-tunable values, which the Settings page writes.

# -- Identity ------------------------------------------------------------------
ZZ2_ENVIRONMENT=production
ZZ2_BUILD=set-by-deploy-script

# The canonical external URL. Must be https in production — the application
# refuses to start otherwise.
ZZ2_PUBLIC_URL=https://suporte.example.com.br

# -- Binding -------------------------------------------------------------------
# For the systemd deployment use 127.0.0.1. Docker Compose overrides this with
# 0.0.0.0 *inside the container*, while still publishing the port only on the
# VPS loopback interface. In both cases nginx is the only public entry point.
ZZ2_HOST=127.0.0.1
ZZ2_PORT=8080

# Host header allowlist. Set to your real hostnames — with the default "*" a
# request with a forged Host reaches the app, which matters for anything that
# builds absolute URLs.
ZZ2_TRUSTED_HOSTS=suporte.example.com.br

# Leave empty unless a genuinely different origin must call the API. Empty means
# same-origin only, which is correct here: this process serves the pages *and*
# the API. Never "*".
ZZ2_CORS_ORIGINS=

# Trust X-Forwarded-For / X-Forwarded-Proto. Only with a reverse proxy you
# control in front — otherwise clients set their own apparent IP and walk
# straight through the rate limiter.
ZZ2_BEHIND_PROXY=true

# -- State ---------------------------------------------------------------------
# The only directory that needs write permission, and the only one to back up.
ZZ2_DATA_DIR=/var/lib/zz2

# -- Database (Azure Database for PostgreSQL) ----------------------------------
# Only the application server connects. Keep sslmode=require.
ZZ2_DATABASE_URL=postgresql://zz2admin:REPLACE@zz2-tech-pg.postgres.database.azure.com:5432/zz2?sslmode=require
ZZ2_DB_SCHEMA=techSupport
ZZ2_CUSTOMER_HISTORY_SCHEMA=zoho

# -- Sessions --------------------------------------------------------------------
# Signs every session the server issues (password and Microsoft sign-ins).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ZZ2_SESSION_SECRET=
ZZ2_SESSION_TTL_SECONDS=28800

# -- Azure Blob Storage (kit diagrams and PDF manuals) ------------------------------
# Private container. The backend proxies authenticated downloads.
ZZ2_ENABLE_BLOB_STORAGE=true
ZZ2_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=REPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net
ZZ2_AZURE_STORAGE_CONTAINER=zz2-manuals

# -- Sign in with Microsoft (OpenID Connect / Entra ID) ------------------------------
# App registration redirect URI: <ZZ2_PUBLIC_URL>/api/auth/microsoft/callback
# Tenant: a tenant GUID, or "organizations" (any work/school account) or "common"
# (also personal Outlook.com accounts). ZZ2_SAML_ALLOWED_DOMAINS below also limits
# which email domains may sign in this way.
ZZ2_MICROSOFT_ENABLED=false
ZZ2_MICROSOFT_TENANT=organizations
ZZ2_MICROSOFT_CLIENT_ID=
ZZ2_MICROSOFT_CLIENT_SECRET=

# -- Google Apps Script (the legacy ticket sheet) ------------------------------
# Leave both empty to run without the sheet integration; the poller and the
# write-behind queue then stay idle and tickets live only in the database.
ZZ2_APPSCRIPT_URL=https://script.google.com/macros/s/REPLACE/exec
ZZ2_APPSCRIPT_SECRET=REPLACE_WITH_THE_SHARED_SECRET

# -- Limits --------------------------------------------------------------------
ZZ2_MAX_BODY_BYTES=8388608
ZZ2_MAX_UPLOAD_BYTES=26214400

ZZ2_RATE_LIMIT_ENABLED=true
ZZ2_RATE_LIMIT_REQUESTS=240
ZZ2_RATE_LIMIT_WINDOW_SECONDS=60
ZZ2_RATE_LIMIT_WRITE_REQUESTS=60

# -- Observability -------------------------------------------------------------
ZZ2_LOG_LEVEL=INFO
ZZ2_LOG_JSON=true

# -- Feature flags -------------------------------------------------------------
ZZ2_ENABLE_APPSCRIPT_SYNC=true
ZZ2_ENABLE_DB_MIRROR=true

# Background workers run in-process. See deploy/gunicorn.conf.py for why this
# deployment runs exactly one worker process.
ZZ2_ENABLE_BACKGROUND_WORKERS=true

# -- SAML single sign-on (Microsoft Entra ID / university accounts) ------------
# See docs/SAML_AZURE.md for the Entra ID side. Off by default; when on, the
# process refuses to start unless every value below is set.
ZZ2_SAML_ENABLED=false
# Entra "Microsoft Entra Identifier" and "Login URL" (Set up section).
ZZ2_SAML_IDP_ENTITY_ID=https://sts.windows.net/<tenant-id>/
ZZ2_SAML_IDP_SSO_URL=https://login.microsoftonline.com/<tenant-id>/saml2
# Entra "Certificate (Base64)" — the body, with or without the PEM armour.
ZZ2_SAML_IDP_X509_CERT=
# Leave empty to use <ZZ2_PUBLIC_URL>/api/auth/saml/metadata.
ZZ2_SAML_SP_ENTITY_ID=
# Only these email domains may sign in. Comma separated.
ZZ2_SAML_ALLOWED_DOMAINS=mackenzista.com.br,mackenzie.br
ZZ2_SAML_DEFAULT_ROLE=tech
# Optional: <entra-group-object-id>=<role>, comma separated.
ZZ2_SAML_GROUP_ROLE_MAP=
# Deprecated: sessions are signed with ZZ2_SESSION_SECRET.
ZZ2_SAML_SESSION_TTL_SECONDS=28800

# -- Brute-force protection ----------------------------------------------------
# Block an address that presents this many *distinct* rejected credentials
# (bad bearer tokens, forged SAML responses) within the window.
ZZ2_AUTH_LOCKOUT_ENABLED=true
ZZ2_AUTH_LOCKOUT_THRESHOLD=20
ZZ2_AUTH_LOCKOUT_WINDOW_SECONDS=600
ZZ2_AUTH_LOCKOUT_SECONDS=900

# -- Troubleshooting sessions --------------------------------------------------
# auto: database table techSupport.troubleshooting_sessions when
# ZZ2_DATABASE_URL is set, local file otherwise. Values: auto | database | local
ZZ2_TROUBLESHOOTING_STORE=auto
