# -- Runtime state -------------------------------------------------------------
# Everything the running application writes. Never in git: it holds ticket text,
# customer names, drafts and uploaded media.
var/
/data/
*.corrupt
*.part

# -- Secrets -------------------------------------------------------------------
# The real values live in /etc/zz2/zz2.env on the server, or in a local .env that
# stays on the machine. deploy/.env.example is the template and IS tracked.
.env
.env.*
!deploy/.env.example
config.json
credentials.json
sessions.json
login_fails.json
*.pem
*.key

# -- Python --------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# -- Editors and OS ------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~
